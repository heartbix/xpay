# Production (HeartBix XPay). For local Google login, use http://127.0.0.1:3000 instead.
PUBLIC_APP_URL=https://xpay.heartbix.com

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins:
#   https://xpay.heartbix.com
#   http://127.0.0.1:3000   (optional, local)
# Authorized redirect URIs:
#   https://xpay.heartbix.com/api/auth/google/callback
#   http://127.0.0.1:3000/api/auth/google/callback   (optional, local)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth — https://github.com/settings/developers
# Authorization callback URL: https://xpay.heartbix.com/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Hub HD seed (EVM deposits + Alephium group-0 receive addresses). Do not use the demo mnemonic in production.
# HUB_MNEMONIC=
# Optional Alephium-only seed if you want it separate from EVM:
# HUB_ALPH_MNEMONIC=
# Optional deposit floor. Default 0: credit whatever arrives (exchanges already have their own minimums).
# HUB_MIN_DEPOSIT_USDT=0
# After a vault credit, sweep USDT/USDC from the user HD address to the treasury (m/44'/60'/0'/1/0).
# HUB_AUTO_SWEEP=1
# HUB_TREASURY_ADDRESS=
# One-leg network USD used as 2× withdrawal fee (ETH 0.15 → withdraw 0.30). Plus ALPH vault fee in USDT.
# HUB_SWEEP_FEE_USD_ETHEREUM=0.15
# HUB_SWEEP_FEE_USD_BSC=0.02
# HUB_SWEEP_FEE_USD_POLYGON=0.02
# HUB_SWEEP_FEE_USD_ARBITRUM=0.02
# ALPH amount recouped on withdraw; converted at live ALPH/USD, ceiled to 0.01 USDT.
# HUB_VAULT_FEE_ALPH=0.204

# Optional: ALPH/USD override if CoinGecko is unreachable
# ALPH_USD=0.15
# HUB_GAS_ALPH=0.002

# Email (Namecheap Private Email SMTP, or Resend)
# SMTP_SERVER=mail.privateemail.com
# SMTP_PORT=465
# SMTP_USER=admin@heartbix.com
# SMTP_PASSWORD=
# MAIL_FROM=XPay <admin@heartbix.com>
# TICKET_MAIL=xpay-ticket@heartbix.com
# RESEND_API_KEY=
