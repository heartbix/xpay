  "engines": { "node": ">=18" },
  "keywords": ["x402", "xpay", "usdt", "micropayments", "alephium", "http-402"],
  "homepage": "https://xpay.heartbix.com/llms.txt",
  "repository": { "type": "git", "url": "https://github.com/heartbix/xpay" },
  "publishConfig": { "access": "public" }
